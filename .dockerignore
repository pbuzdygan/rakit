# The image is built only from application sources. Local databases, secrets,
# repository metadata, documentation and development artifacts never enter the
# build context.
**
!backend
!backend/**
!frontend
!frontend/**

backend/node_modules
backend/.env*
backend/coverage
backend/data
backend/**/*.db
backend/**/*.sqlite*
backend/**/*.key
backend/**/*.pem
frontend/node_modules
frontend/dist
frontend/.env*
frontend/.cache
frontend/.vite
frontend/coverage
frontend/test-results
**/*.log
